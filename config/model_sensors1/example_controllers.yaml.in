/**/controller_manager:
  ros__parameters:
    use_sim_time: @use_sim_time@
    update_rate: 50

    joint_state_broadcaster:
      type: "joint_state_broadcaster/JointStateBroadcaster"

    mima_controller:
      type: "mima_controller/MimaController"

    fork_trajectory_controller:
      type: "joint_trajectory_controller/JointTrajectoryController"

/**/joint_state_broadcaster:
  ros__parameters:
    use_sim_time: @use_sim_time@
    frame_id: "@robot_prefix@base_link"

/**/mima_controller:
  ros__parameters:
    use_sim_time: @use_sim_time@
    reference_timeout: 2.0
    base_frame_id: "@robot_prefix@base_footprint_link"
    odom_frame_id: "@robot_prefix@odom"
    enable_odom_tf: true
    front_steering: true
    use_stamped_vel: false
    open_loop: false
    reduce_wheel_speed_until_steering_reached: true
    velocity_rolling_window_size: 10
    position_feedback: false
    rear_wheels_names: ["@robot_prefix@rear_right_wheel_rotation_joint", "@robot_prefix@rear_left_wheel_rotation_joint"]
    front_wheels_names: ["@robot_prefix@front_right_wheel_steering_joint", "@robot_prefix@front_left_wheel_steering_joint"]
    wheelbase: 1.7
    front_wheel_track: 0.78
    rear_wheel_track: 1.1
    front_wheels_radius: 0.2285
    rear_wheels_radius: 0.2795

/**/fork_trajectory_controller:
  ros__parameters:
    use_sim_time: @use_sim_time@
    joints:
      - "@robot_prefix@fork_mast_joint"
      - "@robot_prefix@fork_holder_joint"
      - "@robot_prefix@fork_board_joint"

    command_interfaces:
      - position

    state_interfaces:
      - position
