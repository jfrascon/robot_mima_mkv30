# This is a template for creating a repository file. Replace the placeholders with actual values.
#
# Recommendations:
# - For referencing internal repositories from Eurecat or private code repositories, it is advised to use
#   SSH URLs (e.g., git@<server>:<repository_path>). This method requires:
#     1. Possession of an SSH key pair (private and public keys).
#     2. The public key must be registered in the private repository from which you want to download code.
# - For projects hosted on public servers like GitHub, it is recommended to use HTTPS URLs
#   (e.g., https://<server>/<repository_path>).
#
repositories:
    robotics_description:
        type: git
        url: git@gitlab.local.eurecat.org:robotics-automation/eut_robotics_description.git
        version: 6b8445cdc18c0e76adb8ed2e49c5c887959a17db
        #exclude: [] # list of repos files inside repository_path to exclude (optional)
    ros2_launch_helpers:
        type: git
        url: git@gitlab.local.eurecat.org:robotics-automation/eut_ros2_launch_helpers.git
        version: 185df945bf2d91b192cef8fe97eddab7a8aabbf9
        #exclude: [] # list of repos files inside repository_path to exclude (optional)

# The package `perte_controller_mima` is declared as a runtime dependency in
# package.xml because the controller YAML loads `mima_controller/MimaController`.
# In this workspace it is part of the parent `adapta` checkout, not a standalone
# git checkout with its own remote. For that reason it is not listed above.
